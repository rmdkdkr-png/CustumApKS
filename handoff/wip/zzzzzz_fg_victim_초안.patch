+   빈 데로 늘여 그려(하오마루 넘어짐 672da743→c085a0f4 ½ 칸: 폭 69 의 띠, 겐쥬로 뒤집혀 떨어짐 782da427→ab627354 ½ 칸), 실제 두
+   프레임 어디에도 없는 자리에 몸이 나타났다 — 유저 「캐릭터가 날아감」·「날아가는 건 피격자인데」(u164 탐지: 몸이 앞뒤 실제 프레임
+   사이 선분에서 6~17px). 162 의 착지 한도(zzzzz_fg_landing: 실제로 본 뒤 포즈면 자리 차 6·12 까지)로 착지 바뀜에도 더 붙었다.
+   사이 그림 칸의 10% 넘게가 A·B(캐시 자리) 어느 화소에서도 2px 넘게(1배, 체스판 거리) 떨어져 있으면 번진 것으로 보고 그 칸은
+   안 쓴다(그 출력은 캐시가 없을 때처럼 A 그대로 — 실제 게임과 같이 툭 바뀜). 항목·칸마다 한 번 재어 둔다(A·B 그림은 지문으로 정해짐).
+   칼 휘두르기처럼 몸은 그대로고 가는 부분만 멀리 가는 바뀜은 칸 몫이 작아 그대로 쓴다 */
+#define MC_SMEAR_PM 100
+static int mc_smeared(mc_ent *e, int ti, const id_pose *A, const id_pose *B)
+{
+   static uint8_t d[256 * 256];
+   int W = e->w, H = e->h, x, y, it, n = 0, far = 0;
+   const uint8_t *reg = e->buf + e->ro[ti];
+   if (e->smear[ti]) return e->smear[ti] == 2;
+   e->smear[ti] = 1;
+   for (y = 0; y < H; y++)
+      for (x = 0; x < W; x++)
+      {
+         int ax = x + e->cx, ay = y + e->cy, bx = ax - e->bdx, by = ay - e->bdy;
+         d[y * W + x] = (uint8_t)(((ax >= 0 && ay >= 0 && ax < A->w && ay < A->h && A->c[ay * A->w + ax] != ID_NONE) ||
+                                   (bx >= 0 && by >= 0 && bx < B->w && by < B->h && B->c[by * B->w + bx] != ID_NONE)) ? 0 : 3);
+      }
+   for (it = 0; it < 2; it++)                                  /* 체스판 거리(3 = 3 이상) — 앞으로 한 번, 뒤로 한 번 쓸기 */
+      for (y = it ? H - 1 : 0; it ? y >= 0 : y < H; y += it ? -1 : 1)
+         for (x = it ? W - 1 : 0; it ? x >= 0 : x < W; x += it ? -1 : 1)
+         {
+            int v = d[y * W + x], i, j;
+            for (j = -1; j <= 1; j++)
+               for (i = -1; i <= 1; i++)
+               {
+                  int xx = x + i, yy = y + j;
+                  if ((i || j) && xx >= 0 && yy >= 0 && xx < W && yy < H && d[yy * W + xx] + 1 < v) v = d[yy * W + xx] + 1;
+               }
+            d[y * W + x] = (uint8_t)v;
+         }
+   for (y = 0; y < W * H; y++)
+      if ((reg[y >> 3] >> (y & 7)) & 1) { n++; if (d[y] > 2) far++; }
+   if (n && far * 1000 > n * MC_SMEAR_PM) e->smear[ti] = 2;
+   return e->smear[ti] == 2;
+}
 /* 출력 칸 slot 의 몸 p — D+1·D+2 에서 포즈가 바뀌면(제자리) 캐시로. 1 = 계획함 */
