+def t_fixed2(B, A, h, s2, v2, s3, v3): return (B[0], from_hsv(h / 360, s2, v2), from_hsv(h / 360, s3, v3))
+FINAL[6] = ('분홍', lambda B, A: t_fixed2(B, A, 330, 0.4, 1.0, 0.75, 0.6))
