+def preset(name_or_idx, ch, sty):
+    B, A = PAL1[ch][sty]
+    if isinstance(name_or_idx, int): return PRESETS[name_or_idx][1](B, A)
+    for n, f in PRESETS:
+        if n == name_or_idx: return f(B, A)
