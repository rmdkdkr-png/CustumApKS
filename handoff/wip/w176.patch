+SLASH_ICON_ART = [
+ "................",
+ "...........1112.",
+ ".........111223.",
+ ".......1112233..",
+ ".....11122333...",
+ "....1122333.....",
+ "...112233.......",
+ "...12233........",
+ "..112233........",
+ "..12233.........",
+ "..1223..........",
