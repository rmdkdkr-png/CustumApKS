+# ---- refined (v2) ----
+def t_tint2(B, A, hue, s2=0.8, s3=0.85, v2=(0.55, 1.0), v3=(0.2, 0.45)):
+    h2, S2, V2 = hsv(B[1]); hh = hue / 360
