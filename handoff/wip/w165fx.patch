+/* 베기 색 아이콘 16x16(우리 픽셀 그림) — 2x2 타일(위왼·위오른·아래왼·아래오른), 색 1 core · 2 mid · 3 edge · 0 투명 */
+static const uint8_t SLASH_ICON[64] = {
+   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x15, 0x00, 0x5A, 0x00, 0x6B, 0x01, 0xAF, 0x01,
+   0x00, 0x00, 0x58, 0x01, 0xAC, 0x15, 0xF0, 0x5A, 0xC0, 0xAF, 0x00, 0xFC, 0x00, 0xC0, 0x00, 0x00,
+   0xAF, 0x05, 0xBC, 0x06, 0xB0, 0x06, 0xC0, 0x16, 0x00, 0x1B, 0x00, 0x2C, 0x00, 0x30, 0x00, 0x00,
+   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
 #endif
