+    }
+    static final double RIVAL_P = 0.12;
+    static Pick pick(long seed, Me me, int day, Book book, Rng r) {
+        Pick pk = new Pick();
+        if (me.pendingId != null) {                                            // 잡힌 상대 — 붙을 때까지 같은 상대(카드에서 나가도 도망 아님)
