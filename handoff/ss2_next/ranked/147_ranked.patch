+                for (int y : ys) { c.set(3, y, OL); c.set(4, y, OL); c.set(19, y, OL); c.set(20, y, OL); }
+            }
+            if (t == 2 && r.chance(60)) { c.set(8, eyeY - 2, MK); c.set(15, eyeY - 2, MK); }
+        }
+        int g = r.pickW(70, 20, 10);
+        if (g == 1) {
