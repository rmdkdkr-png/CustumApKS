+        return null;
+    }
+    private static void tag(Pick pk, Book book, Me me) {
+        int[] h = book.h2h(pk.p.id);
+        if (pk.p.legacy || h[0] + h[1] >= 4 && Math.abs(h[0] - h[1]) <= 1) pk.tags.add("라이벌");
