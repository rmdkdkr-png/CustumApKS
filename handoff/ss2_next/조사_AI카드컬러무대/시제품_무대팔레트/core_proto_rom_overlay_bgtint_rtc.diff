+/* ==== u159 topicD EXPERIMENT (scratch only): in-memory ROM overlay for stage pick / stage palette variants ====
+   retro_ngp_rom_overlay(cart_addr, data, len): set bytes of the in-memory ROM copy (only inside whitelisted stage regions);
+   data == NULL or len == 0 -> restore every overlaid byte from orig_data and forget. Re-applied by rom_hack() (load + state load). */
+#define OV_MAX 8192
+static uint32 ov_off[OV_MAX]; static uint8 ov_val[OV_MAX]; static int ov_n = 0;
+static int ov_ok(uint32 off)
+{
+   uint32 a = off + 0x200000;
+   if (!MATCH_CATALOG(48, 26)) return 0;
+   return (a >= 0x239056 && a < 0x2390A6)      /* bout -> stage table (10 x 8) */
+       || (a >= 0x259190 && a < 0x25AF88)      /* global palette table incl. zero padding 0x25A9D8.. */
+       || (a >= 0x2CA0E2 && a < 0x2CA1E2)      /* stage table 16 x 16 */
+       || (a >= 0x2D8086 && a < 0x2D8270);     /* palette-set lists (bgc, bg colour, indices) */
+}
+void retro_ngp_rom_overlay(uint32_t cart_addr, const uint8_t *data, uint32_t len)
+{
+   uint32 i; int k;
+   if (!ngpc_rom.data) return;
+   if (!data || !len) {
+      for (k = 0; k < ov_n; k++) ngpc_rom.data[ov_off[k]] = ngpc_rom.orig_data ? ngpc_rom.orig_data[ov_off[k]] : ngpc_rom.data[ov_off[k]];
+      ov_n = 0; return;
+   }
+   for (i = 0; i < len; i++) {
+      uint32 off = cart_addr - 0x200000 + i;
+      if (cart_addr < 0x200000 || off >= ngpc_rom.length || !ov_ok(off)) continue;
+      for (k = 0; k < ov_n; k++) if (ov_off[k] == off) break;
+      if (k == ov_n) { if (ov_n >= OV_MAX) return; ov_off[ov_n++] = off; }
+      ov_val[k] = data[i]; ngpc_rom.data[off] = data[i];
+   }
+}
+static void ov_apply(void) { int k; for (k = 0; k < ov_n; k++) ngpc_rom.data[ov_off[k]] = ov_val[k]; }
