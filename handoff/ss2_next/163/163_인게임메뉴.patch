+                    case LgmPages.SET_FX: n = p.withFx((p.fx + 1) % 3); break;
+                    case LgmPages.SET_LOSS: n = p.withLoss(p.lossCursor == 0 ? 1 : 0); break;
+                    case LgmPages.SET_AUTO: n = p.withAuto(p.autoNextSec == 10 ? 0 : 10); break;
