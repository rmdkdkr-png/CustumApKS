+    }
+
+    /** 메뉴 설정 — 기본 fx 0(보통) · loss 0(설욕전) · auto 0(끔) · remember true · tab 0. 범위 밖 값은 기본으로 */
+    static synchronized MenuModel.Prefs menuPrefs() {
