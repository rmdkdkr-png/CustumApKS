+            default: break;
+        }
+    }
+    /** 줄 어긋남 모양 — 0 그대로 · 1 셔터 · 2 물결(SIN16) */
+    static int rowShiftAt(int shape, int v, int dy, int t) {
+        if (shape == SHAPE_SHUTTER) return ((dy >> 1) & 1) != 0 ? -v : v;
