+        ('CHAIN', from_rows(CHAINB), '라이벌 사슬: 1'),
+        ('CROWN', from_rows(CROWN), '1위 왕관: 1 · 2'),
+        ('PIP_WIN', from_rows(PIPW), '최근 판 찬 알: 1'),
