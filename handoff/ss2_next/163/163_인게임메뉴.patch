+                if (dur < 0 || f < dur) s.shakeDy = (f & 1) != 0 ? -c : c;
+                break;
+            case OP_PALCYCLE:
+                if (dur >= 0 && f >= dur) break;
+                s.pal[(layer * PALS + idx) * 3 + ((a >> 10) & 3) - 1] = palCycleAt(((a >> 12) & 1) != 0, b, c, d, f);
+                break;
+            case OP_FLASH:
+                if (f < FLASH_DUR) { s.flashF = f; s.flashY = b; s.flashCore = c; s.flashEdge = d; }
+                break;
+            case OP_BOB:
