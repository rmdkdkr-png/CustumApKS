+            int n = na + (int) Math.floorDiv((long) (nb - na) * w, 65536L);
+            out |= Math.max(0, Math.min(15, n)) << k;              /* 홀수 주기면 tri = (P+1)/2 라 w > 65536 — native nib_mix 처럼 니블마다 0..15 로(통합에서 정함) */
+        }
+        return out;
+    }
