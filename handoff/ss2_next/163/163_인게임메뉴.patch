+        double omm = Math.round(v.mmr * 10) / 10.0;                         /* newRankedMatch 가 start.opp_mmr 에 적는 값 */
+        int omr = v.mr > 0 ? v.mr : (int) Math.round(1500 + (omm - 1600) * 1.5);
