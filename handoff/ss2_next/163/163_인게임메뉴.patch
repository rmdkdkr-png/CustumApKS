+            case EASE_OUT: k = 65536 - (((65536 - u) * (65536 - u)) >> 16); break;
+            case EASE_IN: k = (u * u) >> 16; break;
+            case EASE_STEP: k = 0; break;
+            default: k = u; break;
+        }
