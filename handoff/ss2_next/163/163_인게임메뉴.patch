+    if '--out' in sys.argv:
+        out = sys.argv[sys.argv.index('--out') + 1]
+    arts = build(repo)
+    src = java(arts)
+    with open(out, 'w', encoding='utf-8', newline='\n') as fh:
+        fh.write(src)
+    print('OvArt.java: %d 그림, %d 바이트 → %s' % (len(arts), len(src.encode('utf-8')), out))
