+        /** 바탕 setter 흉내(시험용) */
+        State setPal(int layer, int p, int c1, int c2, int c3) { pal[(layer * PALS + p) * 3] = c1; pal[(layer * PALS + p) * 3 + 1] = c2; pal[(layer * PALS + p) * 3 + 2] = c3; return this; }
