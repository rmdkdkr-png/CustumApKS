+    cv.fill(0, 0, 6, 2, 2)
+    return cv.rows()
+
+
+def sheath_edge():
+    return ['2' + ('1' if (y // 4) % 4 else '2') for y in range(16)]
+
+
+def crest32():
+    """승급 문장 32×32 — 작은 CREST(8×8 마름모: 3 테 · 1 몸 · 2 속)를 32로 다시 그림(우리 그림):
+    1px 바깥 테(3) · 몸(1)을 십자 홈(3)으로 네 면 · 속 테(3) · 속(2) · 속 왼위 빛(1)"""
+    cv = Canvas(32, 32)
+    for y in range(32):
+        for x in range(32):
+            dx, dy = x - 15.5, y - 15.5
+            d = abs(dx) + abs(dy)
+            if d > 16:
+                continue
+            if d > 15:
+                v = 3
+            elif d > 9:
+                v = 3 if (abs(dx) < 1 or abs(dy) < 1) else 1
+            elif d > 8:
+                v = 3
+            else:
+                v = 1 if dx + dy < -4 else 2
+            cv.px(x, y, v)
+    return cv.rows()
+
+
+def gauge_pieces():
+    """LP 막대 조각 8×6 — 목업 gauge() 의 테(2)·찬 몫(윗줄 1 + 2)·잃은 꼬리(1)·빈 몫(3 = 옻칠 몸통)을 칸 단위로(왼끝·가운데·오른끝 × 빔·참·꼬리)"""
+    out = []
+    for state in ('EMPTY', 'FULL', 'TAIL'):
+        for pos in ('L', 'M', 'R'):
+            cv = Canvas(8, 6)
+            for x in range(8):
+                cv.px(x, 0, 2)
+                cv.px(x, 5, 2)
+                for yy in range(1, 5):
+                    if state == 'EMPTY':
+                        v = 3
+                    elif state == 'FULL':
+                        v = 1 if yy == 1 else 2
+                    else:
+                        v = 1
+                    cv.px(x, yy, v)
+            if pos == 'L':
+                for yy in range(6):
+                    cv.px(0, yy, 2)
+            if pos == 'R':
+                for yy in range(6):
+                    cv.px(7, yy, 2)
+            out.append(('GAUGE_%s_%s' % (pos, state), cv.rows()))
+    return out
+
+
+def slash():
+    """사선(45°) 한 칸 — 칼 휘두름·호명 띠 끝·일섬 장식용, 뒤집기로 네 방향: 오른아래 삼각 몸(1) · 사선 테(2)"""
+    cv = Canvas(8, 8)
+    for y in range(8):
+        for x in range(8):
+            s = x + y
+            cv.px(x, y, 2 if s == 7 else (1 if s > 7 else 0))
+    return cv.rows()
+
+
+# ---------------------------------------------------------------- 목록(번호 = 이 순서. 앞 24개는 계약서 §6 표 순서)
+def build(repo):
