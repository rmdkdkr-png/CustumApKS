+    private boolean upload(LgmPages.Scene sc) {
+        boolean ok = true;
+        if (sc.w != null) ok = uploadEnc(Emu.OV_W, sc.w);
+        if (ok && sc.l != null) for (TileCanvas.Encoded e : sc.l) if (e != null && !uploadEnc(Emu.OV_L, e)) { ok = false; break; }
