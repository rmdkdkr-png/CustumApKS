+                    if (sc.rows != null && sc.rows.length > 0) moveCursor(step);
+                    else scrollList(step);
+                }
+                if ((rise & IN_A) != 0 && sc.rows != null && sc.rows.length > 0) select(cursor);
+                else if ((rise & (IN_B | IN_OPT)) != 0) closeDrawer();
+                break;
+            default: break;
+        }
+    }
