+                break;
+            default: break;
+        }
+    }
+    /** PALCYCLE 색 — 부드럽게: 삼각 섞기(니블마다, 0..15 로 자름) · 깜빡: 반 주기마다 A/B (계약서 §4.4) */
+    static int palCycleAt(boolean toggle, int A, int B, int P, int f) {
