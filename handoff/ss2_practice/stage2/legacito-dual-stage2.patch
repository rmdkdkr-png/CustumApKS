+      uint16_t v = 0;
+      for (int x = 0; x < 8; x++) {
+         int on = (ARROW_R[y] >> (7 - (left ? 7 - x : x))) & 1;
+         v |= (uint16_t)((on ? 1 : 3) << (14 - 2 * x));
