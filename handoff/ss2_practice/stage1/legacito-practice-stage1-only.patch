+void practice_settings_set(const void *buf, size_t n);
+/* 시험용 — 연습 경기 상태 통째로 보관·되돌리기(코어 상태와 함께 결정성 시험에) */
+size_t practice_state_size(void);
+void practice_state_get(void *buf);
+void practice_state_set(const void *buf);
