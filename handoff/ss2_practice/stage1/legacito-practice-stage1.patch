+         if (!P.rec_open[d] && combo == 0 && P.f - P.dmg_f[d] > 40) P.dmg_cur[d] = 0;   /* 콤보 수 없이 깎임(가드 깎임) — 따로 센다 */
+         P.dmg_cur[d] += P.prev_hp[d] - hp; P.dmg_f[d] = P.f; P.shown_side = d;
+      }
