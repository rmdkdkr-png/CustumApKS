+/* 고른 상대로 무장하기 직전 — 배경(−1 상대 기본 · −2 무작위 · 0~7)과 컬러를 다음 무장에 넘긴다 */
+static void hub_set_look(int picked)
+{
+   int st = H.stage_sel;
+   if (st == -1) st = (picked >= 0 && picked < 15) ? H.home[picked] : -1;
+   else if (st == -2) st = (int)((H.f * 5u + 3u) % 8u);
+   look_stage = (st >= 0 && st <= 7) ? st : -1;
+   look_color = H.color;
