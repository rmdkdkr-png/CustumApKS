+
+    /** 연습을 켤 수 있는 판인가 — 사무쇼2 일반 세션이고 사본이 실측한 판이거나 그 판에 배경음악만 심은 것 */
+    private boolean practiceRomOk() {
+        if (!loaded || ranked() || game == null || !"ss2".equals(game.id)) return false;
