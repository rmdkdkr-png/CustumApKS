+   if (g_ram) for (int b = 0; b < 2; b++) {
+      if (!W.open) W.fx_orig[b] = g_ram[WBX[b]];
+      else if (W.fx_orig[b] >= 0 && g_ram[WBX[b]] != 0) W.fx_orig[b] = g_ram[WBX[b]];   /* 게임이 그사이 썼다 — 새 원래 값 */
+      g_ram[WBX[b]] = 0;
+   }
