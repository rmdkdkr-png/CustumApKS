+    static JSONObject matchById(String id) {
+        if (id == null) return null;
+        JSONArray a = matches();
+        for (int i = a.length() - 1; i >= 0; i--) if (id.equals(a.optJSONObject(i).optString("id"))) return a.optJSONObject(i);
+        return null;
+    }
