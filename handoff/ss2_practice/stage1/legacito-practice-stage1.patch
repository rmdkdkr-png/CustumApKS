+      switch (PS.guard) {
+      case 1: g = 1; break;
+      case 2:                                    /* 첫 타 뒤: 콤보 첫 타는 맞고, 다시 움직일 수 있게 되는 순간부터 켬 · 1초(움직일 수 있는 60프레임) 안 맞으면 끔 */
+         if (combo2 > 0 && P.ag_prev == 0 && !P.ag_on) P.ag_wait = 1;
