+    /** 결과를 점수·전적·연승·순위에 반영한다(메모리만 — 저장은 호출자). 구간은 시작 때 저장한 두 점수로. */
+    private static void apply(JSONObject m, JSONObject me, JSONObject o, String out) throws Exception {
