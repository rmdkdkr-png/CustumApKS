+        try {
+            JSONObject rule = m.optJSONObject("rule");
+            JSONObject o = oppById(m.optString("opp"));
+            JSONObject me = me();
+            int bits = st[5], w1 = st[6], w2 = st[7], p1 = st[10], p2 = st[11];
